    {
      "parameters": {
        "jsCode": "function chunkText(text, target = 768, tolerance = 200) {\n  const chunks = [];\n  let pos = 0;\n\n  const minSize = target - tolerance;\n  const maxSize = target + tolerance;\n\n  while (pos < text.length) {\n\n    if (text.length - pos <= maxSize) {\n      chunks.push(text.slice(pos).trim());\n      break;\n    }\n\n    const start = pos + minSize;\n    const end = pos + maxSize;\n\n    let split = text.lastIndexOf(\"\\n\", end);\n\n    if (split < start) {\n      split = text.lastIndexOf(\".\", end);\n    }\n\n    if (split < start) {\n      split = pos + target;\n    }\n\n    chunks.push(text.slice(pos, split).trim());\n\n    pos = split;\n\n    while (/\\s/.test(text[pos])) {\n      pos++;\n    }\n  }\n\n  return chunks;\n}\n\n\nconst text = $input.first().json.text;\n\nconst chunks = chunkText(text);\n\nreturn chunks.map((chunk,index)=>({\n  json:{\n    chunk,\n    source:$json.fileName,\n    chunkIndex:index,\n    totalChunks:chunks.length\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "968f7897-0095-41d2-b471-5749c774dae9",
